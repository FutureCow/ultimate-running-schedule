NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# CARTO basemap key for the activity map (https://carto.com/basemaps/apikey).
# Optional: without it the map falls back to OpenStreetMap tiles, which need no
# key. Baked into the browser bundle at build time, so it is public by nature —
# restrict it to your own domains in the CARTO dashboard.
NEXT_PUBLIC_CARTO_API_KEY=
